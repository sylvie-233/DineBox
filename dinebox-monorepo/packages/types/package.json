{
  "name": "@dinebox/types",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DineBox 共享类型：API 响应、DTO、枚举与展示常量",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@dinebox/eslint-config": "workspace:*",
    "@dinebox/tsconfig": "workspace:*",
    "eslint": "^9.18.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5"
  }
}
