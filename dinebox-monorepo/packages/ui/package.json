{
  "name": "@dinebox/ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DineBox 共享 UI：分页算法、浮层 Hook 与后台视觉组件",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@dinebox/utils": "workspace:*"
  },
  "peerDependencies": {
    "lucide-react": "^0.468.0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@dinebox/eslint-config": "workspace:*",
    "@dinebox/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
