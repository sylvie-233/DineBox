{
  "name": "@dinebox/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DineBox API（Hono + MySQL + RustFS + 局域网 ESC/POS 打印）",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts --format esm --dts --clean --target node20",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@dinebox/cache": "workspace:*",
    "@dinebox/db": "workspace:*",
    "@dinebox/logger": "workspace:*",
    "@dinebox/print": "workspace:*",
    "@dinebox/storage": "workspace:*",
    "@dinebox/types": "workspace:*",
    "@dinebox/utils": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "0.12.22",
    "bcryptjs": "^3.0.2",
    "dotenv": "^18.0.9",
    "hono": "^4.6.16",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@dinebox/eslint-config": "workspace:*",
    "@dinebox/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
