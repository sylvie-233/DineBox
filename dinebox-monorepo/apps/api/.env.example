# DineBox API 环境变量（复制为 apps/api/.env 后按需修改）
NODE_ENV=development
PORT=3100
HOST=0.0.0.0

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=dinebox
DB_PASSWORD=123456
DB_NAME=dinebox
DB_CONNECTION_LIMIT=10

# JWT（生产环境必须替换为 ≥32 位随机串）
JWT_SECRET=dinebox-dev-secret-change-me-please
JWT_EXPIRES_IN=604800

# 允许跨域的前端地址
CORS_ORIGIN=http://localhost:8090,http://localhost:8091,http://localhost:3001

# 顾客 H5 公网地址：后台二维码链接 = ${H5_PUBLIC_URL}/?tk=<qr_token>
H5_PUBLIC_URL=http://localhost:8090

LOG_LEVEL=info
LOG_PRETTY=true

# 缓存与限流（memory 本地进程内 / redis 多实例共享）
CACHE_DRIVER=memory
CACHE_PREFIX=dinebox
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
RATE_LIMIT_ENABLED=true

# RustFS / S3 兼容对象存储（菜品图片）
S3_ENDPOINT=http://127.0.0.1:9100
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=dinebox
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=

# 局域网打印：中文热敏打印机默认 GBK；58mm 纸宽 32，80mm 纸宽 48
PRINT_ENCODING=gbk
PRINT_TIMEOUT_MS=5000
PRINT_WIDTH=32
