{
  "name": "@dinebox/escpos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DineBox ESC/POS 虚拟打印机：TCP 9100 + HTTP 接入、指令解析与小票模拟预览",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --port 3003",
    "build": "tsc --noEmit && vite build && tsup src/server/index.ts --format esm --target node20 --out-dir dist-server --clean",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "clean": "rimraf dist dist-server .turbo"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.16",
    "iconv-lite": "^0.6.3",
    "jsbarcode": "^3.11.6",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@dinebox/eslint-config": "workspace:*",
    "@dinebox/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
