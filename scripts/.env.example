# 复制为 scripts/.env 后按需修改；docker compose 会自动读取同目录 .env。
#
# 生产部署前必须修改：
#   - MYSQL_ROOT_PASSWORD / MYSQL_PASSWORD
#   - JWT_SECRET（至少 32 位随机字符串）
#   - S3_ACCESS_KEY / S3_SECRET_KEY
# 并把 H5_PUBLIC_URL 改为店内主机/局域网可访问的地址（手机扫码需要）。

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=dinebox
MYSQL_USER=dinebox
MYSQL_PASSWORD=123456
# 宿主机端口刻意避开常见的 3306，防止与其它项目冲突
MYSQL_PORT=3307

# ---------- Redis（缓存 / 限流） ----------
REDIS_PORT=6380
CACHE_PREFIX=dinebox
RATE_LIMIT_ENABLED=true

# ---------- RustFS（S3 兼容对象存储，保存菜品图片） ----------
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_REGION=us-east-1
S3_BUCKET=dinebox
S3_PORT=9100
# 管理控制台端口
S3_CONSOLE_PORT=9101

# ---------- API ----------
API_PORT=3100
JWT_SECRET=dinebox-dev-secret-change-me-please
# 7 天（秒）
JWT_EXPIRES_IN=604800
CORS_ORIGIN=http://localhost:8090,http://localhost:8091,http://localhost:3001,http://localhost:3002

# 顾客 H5 公网地址：后台二维码链接 = ${H5_PUBLIC_URL}/?tk=<qr_token>
# 手机扫码时请改为店内局域网 IP，如 http://192.168.1.10:8090
H5_PUBLIC_URL=http://localhost:8090

# 局域网打印：中文热敏打印机默认 GBK；58mm 纸宽 32，80mm 纸宽 48
PRINT_ENCODING=gbk
PRINT_TIMEOUT_MS=5000
PRINT_WIDTH=32

# ---------- Web / Admin ----------
# 顾客 H5 宿主机端口（容器内 Next 监听 3001）
WEB_PORT=8090
# 商家管理/收银端宿主机端口（容器内 Nginx 监听 80）
ADMIN_PORT=8091
